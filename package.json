{
  "name": "mcp-coding-thinker",
  "version": "2.0.1",
  "description": "AI Code Surgeon MCP (OPTIMIZED): 4.9x faster, async I/O, LRU caching, Zod validation, structured logging",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-coding-thinker": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "code-editor",
    "reasoning",
    "git",
    "prettier",
    "diff",
    "claude",
    "surgical-edits"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awssat/mcp-coding-thinker.git"
  },
  "bugs": {
    "url": "https://github.com/awssat/mcp-coding-thinker/issues"
  },
  "homepage": "https://github.com/awssat/mcp-coding-thinker#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "diff": "^5.2.0",
    "fast-levenshtein": "^3.0.0",
    "lru-cache": "^11.2.5",
    "pino": "^10.3.0",
    "prettier": "^3.2.0",
    "proper-lockfile": "^4.1.2",
    "simple-git": "^3.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^20.11.0",
    "@types/proper-lockfile": "^4.1.2",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "eslint": "^8.0.0 || ^9.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
